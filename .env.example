# Copie este modelo para .env e ajuste os dados do seu ambiente.
# O .env local não é versionado; este exemplo faz parte do repositório.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/C.I.R.C.U.I.T.O/public

# Client ID público do aplicativo Web no Google Cloud (Google Identity Services).
# Este ID é público e aceita as origens cadastradas no Google Cloud.
# Este fluxo não usa Client Secret. Para outro projeto Google, substitua o ID.
GOOGLE_CLIENT_ID=752327427766-18dnuenkk5mcuq73a96hn1b6kkcqpt97.apps.googleusercontent.com

DB_CONNECTION=mysql
DB_PROFILE=xampp
DB_HOST=127.0.0.1
# Neste XAMPP o MySQL usa 3307. Ajuste para 3306 se essa for a sua porta.
DB_PORT=3307
DB_DATABASE=circuito
DB_USERNAME=root
DB_PASSWORD=

# Serviço institucional usado para validar CPF e senha no modo SIGAA.
IFFAR_AUTH_URL=https://www3.fw.iffarroupilha.edu.br/auth/index.php

# No servidor, ajuste também estas variáveis no .env:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://circuito.alwaysdata.net
# DB_PROFILE=alwaysdata
ALWAYSDATA_DB_HOST=seu-host-alwaysdata
ALWAYSDATA_DB_PORT=3306
ALWAYSDATA_DB_DATABASE=seu-banco-alwaysdata
ALWAYSDATA_DB_USERNAME=seu-usuario-alwaysdata
ALWAYSDATA_DB_PASSWORD=sua-senha-alwaysdata

# Preencha senhas reais somente no .env de cada ambiente, nunca neste exemplo.
